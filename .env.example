# Copy this file to `.env` and fill in real values for local `netlify dev`.
# `.env` is gitignored. In production, set the same vars in the Netlify
# dashboard (Site settings → Environment variables), NOT in this file.

# Your secret ElevenLabs API key (xi-api-key). Server-side only — never shipped
# to the browser.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# The ElevenLabs agent the voice button talks to.
ELEVENLABS_AGENT_ID=agent_7801kvxryqnkfwhbr419xfwsyjw3
